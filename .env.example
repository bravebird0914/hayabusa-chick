# ============================================================
#  切り替えはここだけです。使いたいプロバイダを1つ書いてください。
#    openai     (別名: gpt)
#    anthropic  (別名: claude)
#    gemini     (別名: google)
# ============================================================
LLM_PROVIDER=openai

# モデル名を変えたいときだけ書いてください。空なら各プロバイダのデフォルトを使います。
#   openai     デフォルト: gpt-5.6
#   anthropic  デフォルト: claude-sonnet-5
#   gemini     デフォルト: gemini-3.6-flash
LLM_MODEL=

# --- APIキー(使うプロバイダの行だけコメントを外して記入) ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# GPT-5系のみ。gpt-4o などを使う場合は値を空にしてください。
# OPENAI_REASONING_EFFORT=none

# 叩き台の押しルール。同じ解答がこの回数続いたら push! します。
# PUSH_STREAK=3

# 運営実行時は、API の向き先がプロキシになることがあります。通常は空で構いません。
# OPENAI_BASE_URL=http://127.0.0.1:4000/v1
# ANTHROPIC_BASE_URL=
# GEMINI_BASE_URL=
